# SQLite (по умолчанию) — для локального запуска ничего менять не нужно
DATABASE_URL="file:./dev.db"

# Перед деплоем на Vercel замените на PostgreSQL:
# 1) в prisma/schema.prisma поставьте provider = "postgresql"
# 2) сюда впишите строку подключения от Neon / Vercel Postgres / Supabase, например:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="сгенерируйте_случайную_строку_через_openssl_rand_-base64_32"
NEXTAUTH_URL="http://localhost:3000"

# Email супер-администратора (устанавливается автоматически при seed/регистрации)
SUPER_ADMIN_EMAIL="adilhananuar426@gmail.com"
